{
  "name": "clawhouse-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend build and component tests for the Clawhouse Databricks App.",
  "scripts": {
    "build": "tsc -p frontend/tsconfig.json",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p frontend/tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
